# Copy to .env and fill in the values (never commit .env).
#   cp .env.example .env

# --- Required ---------------------------------------------------------------
# Admin panel password (leave empty and docker compose refuses to start until you set one).
# The API also refuses to start in production with the development default ("admin").
ADMIN_PASSWORD=

# Secret used to sign admin sessions: 32+ random characters. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Optional ---------------------------------------------------------------
# Public port of the web container (nginx).
HTTP_PORT=8090

# Timezone used for the card date/time and the "cards today" counters.
APP_TIMEZONE=Asia/Riyadh

# Comma-separated origins allowed by CORS. Leave empty when the SPA and API share an origin (the default setup).
TRUSTED_ORIGINS=

# --- Local development without Docker ---------------------------------------
# APP_ENV=development allows the built-in development credentials.
#   cd apps/api && APP_ENV=development DATABASE_PATH=./data/cards.db go run ./cmd/server
#   cd apps/web && npm run dev
# APP_ENV=development
# PORT=8080
# DATABASE_PATH=./data/cards.db
# MIGRATIONS_PATH=./migrations
